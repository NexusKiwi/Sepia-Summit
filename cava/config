# Sepia CAVA theme — used by the terminal `cava` and as a colour reference.
# (The Kurve desktop widget has its own colour settings; use the same hexes.)
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
autosens = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 5
gradient_color_1 = '#4a3221'
gradient_color_2 = '#89654a'
gradient_color_3 = '#c4a074'
gradient_color_4 = '#e4cca2'
gradient_color_5 = '#f5e8ca'

[smoothing]
noise_reduction = 77
