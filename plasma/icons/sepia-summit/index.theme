[Icon Theme]
Name=Sepia Summit
Comment=Cream line icons for a few apps; everything else comes from the theme it inherits
Inherits=@INHERITS@,breeze,hicolor
Directories=scalable/apps,scalable/status

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/status]
Size=22
MinSize=16
MaxSize=512
Type=Scalable
Context=Status
