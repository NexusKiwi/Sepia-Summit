<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="itemId" type="String"><default>OpenRGB</default></entry>
    <entry name="icon" type="String"><default>OpenRGB</default></entry>
    <entry name="label" type="String"><default>OpenRGB</default></entry>
